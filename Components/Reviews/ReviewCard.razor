@namespace Univents.Components.Reviews
@using Univents.Models

<article class="rounded-2xl p-5 transition-all duration-150 border" style="background:#ffffff; box-shadow:0 2px 10px rgba(26,26,26,0.06); border-color:@(isHovering ? "#d9e58d" : "transparent");"
         @onmouseenter="() => isHovering = true" @onmouseleave="() => isHovering = false">

    <div class="flex items-center">
        <div class="flex items-center justify-center rounded-xl flex-shrink-0" style="width:42px; height:42px; background:@(Review.AvatarColor); color:#1a1a1a; font-family:'Outfit', sans-serif; font-weight:900; font-size:12px;">
            @Review.Avatar
        </div>

        <div class="grid ml-3" style="gap:3px;">
            <div class="flex items-center flex-wrap gap-1.5">
                <strong class="text-sm" style="font-family:'Inter', sans-serif; font-weight:600;">@Review.Name</strong>
                @if (Review.Verified)
                {
                    <span class="inline-flex items-center rounded-full px-2 py-0.5" style="background:#eff8c2; color:#5c6b09; font-size:9px; gap:2px;">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>
                        Verified attendee
                    </span>
                }
            </div>
            <span style="color:#999; font-size:10px;">@Review.Date</span>
        </div>

        <div class="grid ml-auto text-right" style="gap:3px; justify-items:end;">
            <StarRating Value="Review.Rating" SizePx="12" />
            <strong style="font-size:11px; font-family:'Inter', sans-serif; font-weight:600;">@($"{Review.Rating}.0")</strong>
        </div>
    </div>

    <h3 class="mt-5 mb-1.5" style="font-family:'Outfit', sans-serif; font-weight:700; font-size:16px;">@Review.Title</h3>
    <p class="mb-4" style="color:#64645f; font-size:13px; line-height:1.65;">@Review.Text</p>

    <button type="button" @onclick="HandleToggleHelpful"
            class="inline-flex items-center bg-transparent border-0 p-0 transition-colors"
            style="gap:6px; font-size:10px; color:@(IsHelpful ? "#718600" : "#888");">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 21H4V10h3m0 11h9.5a2 2 0 0 0 2-1.7l1.2-7A2 2 0 0 0 17.8 10H14l.7-3.1A3.2 3.2 0 0 0 11.6 3L7 10v11Z" />
        </svg>
        Helpful (@(Review.Helpful + (IsHelpful ? 1 : 0)))
    </button>
</article>

@code {
    [Parameter, EditorRequired] public ReviewItem Review { get; set; } = null!;
    [Parameter] public bool IsHelpful { get; set; }
    [Parameter] public EventCallback<int> OnToggleHelpful { get; set; }

    private bool isHovering;

    private Task HandleToggleHelpful() => OnToggleHelpful.InvokeAsync(Review.Id);
}
